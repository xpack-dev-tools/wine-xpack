  "xpack": {
    "minimumXpmRequired": "0.20.8",
    "dependencies": {},
    "devDependencies": {
      "@xpack-dev-tools/mingw-w64-gcc": {
        "specifier": "15.2.0-1.1",
        "local": "link",
        "platforms": "win32-x64,darwin-x64,darwin-arm64,linux-x64,linux-arm64"
      }
    },
    "properties": {},
    "actions": {
      "compile-ia32": [
        "i686-w64-mingw32-gcc -o hello-ia32.exe src/hello.c"
      ],
      "compile-x64": [
        "x86_64-w64-mingw32-gcc -o hello-x64.exe src/hello.c"
      ]
    },
    "buildConfigurations": {}
  }
